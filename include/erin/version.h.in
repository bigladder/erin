#ifndef ERIN_VERSION_H
#define ERIN_VERSION_H
#include <string>

namespace erin::version
{
  constexpr int major_version{@PROJECT_VERSION_MAJOR@};
  constexpr int minor_version{@PROJECT_VERSION_MINOR@};
  constexpr int release_number{@PROJECT_VERSION_PATCH@};
